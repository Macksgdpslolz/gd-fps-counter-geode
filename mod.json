{
    "geode": "6.0.0-alpha.2",
    "gd": {
        "android": "2.2091",
        "win": "2.2091"
    },
    "id": "player.simple_fps",
    "name": "Simple FPS",
    "version": "v1.1.0",
    "developer": "Player",
    "description": "Simple customizable FPS counter",
    "settings": {
        "update-interval": {
            "name": "Update Interval (sec)",
            "description": "How often FPS updates in seconds (e.g. 0.1 - fast, 0.5 - smooth)",
            "type": "float",
            "default": 0.25,
            "min": 0.05,
            "max": 2.0,
            "control": {
                "slider": true,
                "slider-step": 0.05
            }
        },
        "scale": {
            "name": "Size (Scale)",
            "description": "Text size of the FPS counter",
            "type": "float",
            "default": 0.4,
            "min": 0.15,
            "max": 1.2,
            "control": {
                "slider": true,
                "slider-step": 0.05
            }
        },
        "opacity": {
            "name": "Opacity",
            "description": "Transparency from 0 (invisible) to 255 (solid)",
            "type": "int",
            "default": 180,
            "min": 10,
            "max": 255,
            "control": {
                "slider": true
            }
        },
        "corner": {
            "name": "Position (Corner)",
            "description": "Screen corner where FPS counter is placed",
            "type": "string",
            "default": "Top-Left",
            "one-of": [
                "Top-Left",
                "Top-Right",
                "Bottom-Left",
                "Bottom-Right"
            ]
        },
        "offset-x": {
            "name": "Offset X",
            "description": "Horizontal margin from the screen edge",
            "type": "float",
            "default": 5.0,
            "min": 0.0,
            "max": 200.0,
            "control": {
                "slider": true,
                "slider-step": 1.0
            }
        },
        "offset-y": {
            "name": "Offset Y",
            "description": "Vertical margin from the screen edge",
            "type": "float",
            "default": 5.0,
            "min": 0.0,
            "max": 200.0,
            "control": {
                "slider": true,
                "slider-step": 1.0
            }
        }
    }
}
